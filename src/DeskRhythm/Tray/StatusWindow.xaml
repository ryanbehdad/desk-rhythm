<Window x:Class="DeskRhythm.Tray.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DeskRhythm.Theming"
        Title="Desk Rhythm"
        Width="376"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="14">
        <Border Style="{StaticResource CardShadow}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="20,12,12,18">

                <!-- Header -->
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10"
                            ToolTip="Close (Desk Rhythm keeps running)" AutomationProperties.Name="Close panel" />
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14"
                            ToolTip="Settings" AutomationProperties.Name="Settings" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Desk Rhythm" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                        <Border x:Name="TestBadge" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                            <TextBlock Text="TEST MODE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Phase and countdown -->
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <theme:PhaseGlyph x:Name="Glyph" Width="36" Height="36" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PhaseLabel" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Text="Sitting" />
                        <TextBlock x:Name="BigText" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="30:00" />
                    </StackPanel>
                </Grid>

                <!-- Progress -->
                <Grid x:Name="ProgressTrack" Height="4" Margin="0,14,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressDone" Width="0*" />
                        <ColumnDefinition x:Name="ProgressLeft" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                    <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                </Grid>

                <TextBlock x:Name="DetailText" Margin="0,10,8,0" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />

                <!-- Main actions (rebuilt when the state changes) -->
                <WrapPanel x:Name="ActionPanel" Margin="0,16,0,0" />

                <!-- Resynchronise -->
                <Border Height="1" Margin="0,16,8,12" Background="{DynamicResource StrokeBrush}" />
                <TextBlock Text="I'm now…" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,8" />
                <UniformGrid x:Name="SwitchPanel" Columns="3" Margin="0,0,8,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
