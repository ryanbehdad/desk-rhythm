<Window x:Class="DeskRhythm.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DeskRhythm.Theming"
        Title="Desk Rhythm settings"
        Width="860"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,22,28,20">

            <!-- Header -->
            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,18"
                       Text="Changes save automatically and apply right away." />
            <Border x:Name="TestModeNote" Style="{StaticResource Section}" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" Padding="14,10">
                <TextBlock TextWrapping="Wrap" Text="Test mode: phases last 10 s / 5 s / 3 s (no standing desk: 10 s / 4 s), and every other 'minute' in this window counts as one second." />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Your routine" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="New durations and desk changes apply from the next phase." />

                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="DeskYes" GroupName="Desk" Style="{StaticResource ChoiceChip}" Content="Standing desk" />
                                <RadioButton x:Name="DeskNo" GroupName="Desk" Style="{StaticResource ChoiceChip}" Content="No standing desk" />
                            </WrapPanel>
                            <TextBlock x:Name="DeskHint" Style="{StaticResource Hint}" Margin="0,0,0,14" TextWrapping="Wrap" />

                            <StackPanel x:Name="StandingDeskPanel">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <theme:PhaseGlyph x:Name="SitGlyph" Phase="Sitting" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Sitting" />
                                    <TextBlock x:Name="SittingValue" Grid.Column="2" Style="{StaticResource Label}" FontWeight="SemiBold" Text="30 min" />
                                    <Slider x:Name="SittingSlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Minimum="5" Maximum="120"
                                            AutomationProperties.Name="Sitting duration in minutes" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <theme:PhaseGlyph x:Name="StandGlyph" Phase="Standing" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Standing" />
                                    <TextBlock x:Name="StandingValue" Grid.Column="2" Style="{StaticResource Label}" FontWeight="SemiBold" Text="15 min" />
                                    <Slider x:Name="StandingSlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Minimum="1" Maximum="60"
                                            AutomationProperties.Name="Standing duration in minutes" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <theme:PhaseGlyph x:Name="MoveGlyph" Phase="Moving" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Moving (short walk)" />
                                    <TextBlock x:Name="MovingValue" Grid.Column="2" Style="{StaticResource Label}" FontWeight="SemiBold" Text="2 min" />
                                    <Slider x:Name="MovingSlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Minimum="1" Maximum="15"
                                            AutomationProperties.Name="Movement duration in minutes" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="SitOnlyPanel">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <theme:PhaseGlyph x:Name="SitOnlyGlyph" Phase="Sitting" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Sitting" />
                                    <TextBlock x:Name="SitOnlySittingValue" Grid.Column="2" Style="{StaticResource Label}" FontWeight="SemiBold" Text="40 min" />
                                    <Slider x:Name="SitOnlySittingSlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Minimum="5" Maximum="120"
                                            AutomationProperties.Name="Sitting duration without a standing desk, in minutes" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <theme:PhaseGlyph x:Name="BreakGlyph" Phase="Moving" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Walking break" />
                                    <TextBlock x:Name="SitOnlyBreakValue" Grid.Column="2" Style="{StaticResource Label}" FontWeight="SemiBold" Text="5 min" />
                                    <Slider x:Name="SitOnlyBreakSlider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Minimum="1" Maximum="15"
                                            AutomationProperties.Name="Walking break duration in minutes" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="While you're away" />

                            <CheckBox x:Name="LockToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Pause when Windows is locked or asleep" />
                                    <TextBlock Style="{StaticResource Hint}" Text="No pile of reminders when you come back." />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox x:Name="IdleToggle" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Pause when the keyboard and mouse are idle" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Off by default: you may be reading or in a meeting. Only the idle time is read." />
                                </StackPanel>
                            </CheckBox>

                            <Grid x:Name="IdleRow" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Idle for" />
                                <TextBlock x:Name="IdleValue" Grid.Column="1" Style="{StaticResource Label}" FontWeight="SemiBold" Text="10 min" />
                                <Slider x:Name="IdleSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Minimum="2" Maximum="60"
                                        AutomationProperties.Name="Idle time before pausing, in minutes" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Reminders" />

                            <TextBlock Style="{StaticResource Label}" Text="Show reminders on" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton x:Name="MonitorsAll" GroupName="Monitors" Style="{StaticResource ChoiceChip}" Content="All monitors" />
                                <RadioButton x:Name="MonitorsMouse" GroupName="Monitors" Style="{StaticResource ChoiceChip}" Content="Monitor with mouse" />
                                <RadioButton x:Name="MonitorsPrimary" GroupName="Monitors" Style="{StaticResource ChoiceChip}" Content="Primary monitor" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Label}" Text="Corner" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,10">
                                <RadioButton x:Name="CornerBottomRight" GroupName="Corner" Style="{StaticResource ChoiceChip}" Content="Bottom right" />
                                <RadioButton x:Name="CornerBottomLeft" GroupName="Corner" Style="{StaticResource ChoiceChip}" Content="Bottom left" />
                                <RadioButton x:Name="CornerTopRight" GroupName="Corner" Style="{StaticResource ChoiceChip}" Content="Top right" />
                                <RadioButton x:Name="CornerTopLeft" GroupName="Corner" Style="{StaticResource ChoiceChip}" Content="Top left" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Remind again after an ignored popup" />
                                <TextBlock x:Name="RepromptValue" Grid.Column="1" Style="{StaticResource Label}" FontWeight="SemiBold" Text="5 min" />
                                <Slider x:Name="RepromptSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Minimum="1" Maximum="30"
                                        AutomationProperties.Name="Re-prompt delay in minutes" />
                            </Grid>

                            <TextBlock Style="{StaticResource Label}" Text="Snooze options (minutes)" Margin="0,0,0,6" />
                            <TextBox x:Name="SnoozeBox" AutomationProperties.Name="Snooze options in minutes" />
                            <TextBlock x:Name="SnoozeHint" Style="{StaticResource Hint}" Margin="0,4,0,14"
                                       Text="Up to three numbers, for example 5, 10, 15. The first one is on the reminder." />

                            <CheckBox x:Name="SoundToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Play a soft chime" />
                                    <TextBlock Style="{StaticResource Hint}" Text="One chime per reminder. Off by default for the office." />
                                </StackPanel>
                            </CheckBox>

                            <Button x:Name="TestButton" HorizontalAlignment="Left" Content="Test reminder on all monitors" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Startup and presenting" />

                            <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Launch at Windows sign-in" />
                                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Text="For your user account only. No admin rights needed." />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox x:Name="QuietToggle" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Quiet mode (presenting)" />
                                    <TextBlock x:Name="QuietHint" Style="{StaticResource Hint}" Text="Hides reminders and holds the timer until you turn it off." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="96" IsDefault="True" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ResetButton" Content="Reset settings" Margin="0,0,8,0" />
                    <Button x:Name="FolderButton" Style="{StaticResource LinkButton}" Content="Open settings folder" />
                    <Button x:Name="UninstallButton" Style="{StaticResource LinkButton}" Content="Uninstall…"
                            ToolTip="Turn off launch at sign-in, delete settings and close Desk Rhythm" />
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="Desk Rhythm is a gentle movement prompt, not a health tracker. The timings are a starting point, not medical advice. Nothing leaves this computer." />
        </StackPanel>
    </ScrollViewer>
</Window>
