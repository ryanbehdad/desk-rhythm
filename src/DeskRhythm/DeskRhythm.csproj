<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskRhythm</AssemblyName>
    <RootNamespace>DeskRhythm</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskRhythm.ico</ApplicationIcon>
    <Product>Desk Rhythm</Product>
    <Description>A quiet sit-stand-move reminder for Windows 11.</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF reads per-monitor DPI awareness from app.manifest; the WinForms advice does not apply here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms share type names (Button, Application...). Keep WinForms explicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DeskRhythm.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskRhythm.Core\DeskRhythm.Core.csproj" />
  </ItemGroup>

</Project>
